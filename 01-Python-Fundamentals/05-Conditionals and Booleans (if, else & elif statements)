"""
Topic: [Conditional and Boolean(if, else & elif statement)]


Boolean → a value that is either True or False
 
Boolean operations:

        Equal:             ==
        Not equal:         !=
        Greater then:      >
        Less then:         <
        Greater or equal:  >=
        less or equal:     <=
        object identity:   is

        and (both must be True)
        or (at least one True)
        not (reverses True/False)
"""        

# Boolean example:

num_1 = 3
num_2 = 2

print (num_1==num_2)   # False
print(num_1 != num_2)  # True


""" 

Conditional statements → use booleans to decide what code should run

Python keywords:

if: Runs only if the condition is True.

elif: Choose between two options. 

else: if both are false.

"""
 
language= 'java'

if language == 'python':
   print('python')
elif language == 'java':
   print('java')
else:
   print('nope')   
"""

False Values:

# False
# None
# zero of any numeric type
# any empty sequence (' ', (  ), [ ] )
# any emoty mapping. { }
"""

condition = False

if condition:
   print('true')
else:
   print('false')    
